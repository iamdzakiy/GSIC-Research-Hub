# Database (Supabase Postgres)
DATABASE_URL=            # pooled connection string
DIRECT_URL=              # direct (5432) connection string, used by prisma db push

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=
SUPABASE_PUBLIC_BUCKET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TEASER_VIDEO_URL=
AUTH_ALLOWED_EMAIL_DOMAINS=  # optional, e.g. itb.ac.id,mahasiswa.itb.ac.id. Empty allows all.

# SMTP (GSIC mailbox): welcome, magic-link and password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GSIC Hub <no-reply@example.org>"
SMTP_SECURE=                 # optional; defaults to true on port 465

# Google Sheets (service account)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Admin bootstrap script (scripts/create-admin-account.ts)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
