generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  htaId          String   @default("")
  email          String   @unique
  name           String?
  faculty        String?
  major          String?
  year           Int?
  whatsapp       String?
  avatarUrl      String?
  classcardTheme String   @default("blue")
  skills         String[]
  bio            String?
  isVerified     Boolean  @default(false)
  role           String   @default("user")
  emailConfirmed Boolean  @default(false)
  provider       String   @default("email")
  lastSignInAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registrations Registration[]
  testResults   TestResult[]
  documents     Document[]
}

model Opportunity {
  id             String   @id @default(cuid())
  type           String
  title          String
  organizer      String
  description    String
  requiredSkills String[]
  benefits       String[]
  deadline       DateTime
  isAnnual       Boolean  @default(false)
  link           String?
  posterUrl      String?
  status         String   @default("active")
  cpName         String?
  cpContact      String?
  createdAt      DateTime @default(now())
}

model CuratedOpportunity {
  id          String  @id @default(cuid())
  title       String
  type        String
  organizer   String
  monthOpen   String
  description String
  link        String?
}

model Event {
  id                   String         @id @default(cuid())
  type                 String
  title                String
  description          String
  shortDescription     String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  location             String
  maxParticipants      Int
  currentParticipants  Int            @default(0)
  status               String         @default("upcoming")
  clusters             String[]
  modules              Json
  speakers             Json
  hasPreTest           Boolean        @default(false)
  hasPostTest          Boolean        @default(false)
  preTestId            String?
  postTestId           String?
  preTestExplanation   String?
  postTestExplanation  String?
  createdBy            String
  createdAt            DateTime       @default(now())
  registrations        Registration[]
}

model Test {
  id              String       @id @default(cuid())
  eventId         String
  type            String
  title           String
  description     String?
  questions       Json
  durationMinutes Int
  passingScore    Int
  testResults     TestResult[]
}

model Registration {
  id                String   @id @default(cuid())
  userId            String
  eventId           String
  motivation        String?
  status            String   @default("confirmed")
  preTestCompleted  Boolean  @default(false)
  postTestCompleted Boolean  @default(false)
  registeredAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
}

model TestResult {
  id          String   @id @default(cuid())
  testId      String
  userId      String
  answers     Json
  score       Int
  maxScore    Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  test Test @relation(fields: [testId], references: [id])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  title      String
  author     String?
  type       String
  url        String
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model AdminAccount {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  role        String   @default("admin")
  isGenerated Boolean  @default(true)
  generatedBy String?
  createdAt   DateTime @default(now())
}