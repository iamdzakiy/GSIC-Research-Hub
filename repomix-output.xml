    return (
      <div className="min-h-screen bg-hero-gradient font-body pt-20">
        <Navbar />
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
          <User className="w-16 h-16 text-white/30 mx-auto mb-4" />
