                      <ArrowLeft className="w-3 h-3" /> Back to Sign In
                    </button>
                  </div>

                  {message && <div className="mt-4 text-center text-sm text-white/70">{message}</div>}
                </motion.div>
              )}
            </AnimatePresence>
          </div>
        </motion.div>
      </main>
    </div>
  );
}
