generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum OpportunityType {
  research
  scholarship
  career
  competition
}

enum OpportunityScope {
  internal
  external
}

enum FundingType {
  fully_funded
  partially_funded
  tuition_only
  stipend
  prize_money
  paid
  unpaid
  self_funded
}

enum AttendanceMode {
  onsite
  online
  hybrid
}

enum LinkStatus {
  published
  hidden
}

enum Status {
  active
  archived
  upcoming
  ongoing
  completed
}

enum EventType {
  bootcamp
  sandbox
}

enum DocumentType {
  report
  portfolio
  proposal
  template
  guideline
}

enum PostStatus {
  draft
  published
}

enum TestType {
  pre
  post
}

enum RegistrationStatus {
  pending
  confirmed
  completed
  cancelled
}

enum Theme {
  blue
  mint
  cream
  dark
  purple
  sunset
}

model User {
  id             String   @id @default(cuid())
  htaId          String   @default("")
  email          String   @unique
  name           String?
  faculty        String?
  major          String?
  majorCode      String?
  year           Int?
  whatsapp       String?
  avatarUrl      String?
  classcardTheme Theme    @default(blue)
  skills         String[]
  softSkills     String[]
  interests      String[]
  archetype      String?
  bccRole        String?
  bio            String?
  isVerified     Boolean  @default(false)
  role           UserRole @default(user)
  emailConfirmed Boolean  @default(false)
  provider       String   @default("email")
  lastSignInAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registrations Registration[]
  testResults   TestResult[]
  documents     Document[]
  posts         BlogPost[]
}

model Speaker {
  id          String   @id @default(cuid())
  name        String
  roleTitle   String
  institution String
  avatarUrl   String
  bio         String?
  linkedinUrl String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Opportunity {
  id             String          @id @default(cuid())
  type           OpportunityType
  title          String
  slug           String          @unique
  organizer      String
  description    String
  requiredSkills String[]
  benefits       String[]
  deadline       DateTime
  isAnnual       Boolean         @default(false)
  link           String?
  posterUrl      String?
  status         Status          @default(active)
  cpName         String?
  cpContact      String?
  location       String?
  programBenefits String?        @db.Text
  eligibility    String?         @db.Text
  howToApply     String?         @db.Text
  timeline       Json?
  scope             OpportunityScope @default(external)
  levels            String[]
  benefitCategories String[]
  openDate          DateTime?
  quota             Int?
  // --- rich detail (all optional) ---
  summary             String?          @db.Text
  fundingType         FundingType?
  fundingAmount       String?
  attendanceMode      AttendanceMode?
  city                String?
  country             String?
  ageMin              Int?
  ageMax              Int?
  nationality         String?
  minGpa              Float?
  duration            String?
  programStart        DateTime?
  programEnd          DateTime?
  language            String?
  fieldsOfStudy       String[]
  tags                String[]
  requiredDocuments   String[]
  eligibilityCriteria Json?            // [{ text, required }]
  applySteps          Json?            // [{ title, description }]
  selectionStages     Json?            // [{ stage, description, date? }]
  faqs                Json?            // [{ q, a }]
  quickFacts          Json?            // [{ label, value }] type-specific extras
  socialLinks         Json?            // [{ label, url }]
  tips                String?          @db.Text
  contactEmail        String?
  createdAt      DateTime        @default(now())
  documents      Document[]

  @@index([status])
  @@index([deadline])
  @@index([type])
}

model CuratedOpportunity {
  id          String          @id @default(cuid())
  title       String
  type        OpportunityType
  organizer   String
  monthOpen   String
  description String
  link        String?
}

model Event {
  id                   String        @id @default(cuid())
  type                 EventType
  title                String
  description          String
  shortDescription     String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  location             String
  maxParticipants      Int
  currentParticipants  Int           @default(0)
  status               Status        @default(upcoming)
  clusters             String[]
  modules              Json
  speakers             Json
  hasPreTest           Boolean       @default(false)
  hasPostTest          Boolean       @default(false)
  preTestId            String?
  postTestId           String?
  preTestExplanation   String?
  postTestExplanation  String?
  createdBy            String
  createdAt            DateTime      @default(now())
  registrations        Registration[]
  documents            Document[]
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String     @db.Text
  excerpt     String?    @db.Text
  coverImage  String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  status      PostStatus @default(draft)
  tags        String[]
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model Test {
  id              String       @id @default(cuid())
  eventId         String
  type            TestType
  title           String
  description     String?
  questions       Json
  durationMinutes Int
  passingScore    Int
  testResults     TestResult[]
}

model Registration {
  id                String             @id @default(cuid())
  userId            String
  eventId           String
  motivation        String?
  status            RegistrationStatus @default(confirmed)
  preTestCompleted  Boolean            @default(false)
  postTestCompleted Boolean            @default(false)
  registeredAt      DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
}

model TestResult {
  id          String   @id @default(cuid())
  testId      String
  userId      String
  answers     Json
  score       Int
  maxScore    Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  test Test @relation(fields: [testId], references: [id])
}

model Document {
  id            String       @id @default(cuid())
  userId        String
  title         String
  author        String?
  type          DocumentType
  url           String
  description   String?      @db.Text
  tags          String[]
  opportunityId String?
  eventId       String?
  uploadedAt    DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  event         Event?       @relation(fields: [eventId], references: [id])

  @@index([type])
  @@index([opportunityId])
  @@index([eventId])
}

model ResourceLink {
  id          String     @id @default(cuid())
  title       String
  url         String     @unique
  description String?    @db.Text
  category    String
  tags        String[]
  isFeatured  Boolean    @default(false)
  order       Int        @default(0)
  status      LinkStatus @default(published)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([status])
}


model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  caption     String?
  imageUrl    String
  eventLabel  String?
  takenAt     DateTime?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isPublished, order])
}
