                        <div>
                          <h4 className="font-bold font-heading">{evt.title}</h4>
                          <div className="text-xs text-white/40">{evt.type === "bootcamp" ? "Bootcamp" : "Sandbox"} · {formatDate(evt.startDate)} - {formatDate(evt.endDate)}</div>
