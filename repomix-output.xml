              )}
            >
              {isLast ? <CheckCircle2 className="w-5 h-5" /> : null}
            </span>

            <div className="glass rounded-xl px-4 py-3 border border-white/10">
              <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
